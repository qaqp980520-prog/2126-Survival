+func _serialize_world_state() -> Dictionary:
+	var planted: Array[Dictionary] = []
+	for record in planted_crops:
+		var node: Node3D = record.get("node")
+		if not is_instance_valid(node):
+			continue
+		planted.append({"position": [node.position.x, node.position.y, node.position.z], "mature": bool(node.get_meta("mature", false)), "remaining_growth": maxf(0.0, float(record.get("ready_at", world_time)) - world_time)})
+	var dynamic_crops: Array[Dictionary] = []
+	for node in interactables:
+		if not is_instance_valid(node) or str(node.get_meta("kind", "")) != "crop" or not bool(node.get_meta("dynamic_respawn", false)):
+			continue
+		var p: Vector3 = node.global_position - Vector3(0, 0.2, 0)
+		dynamic_crops.append({"label": str(node.get_meta("display_name", "野生作物")), "position": [p.x, p.y, p.z], "yield_type": str(node.get_meta("yield_type", "berries")), "seed_type": str(node.get_meta("seed_type", "seeds"))})
+	var respawns: Array[Dictionary] = []
+	for record in crop_respawns:
+		var pos: Vector3 = record.get("pos", Vector3.ZERO)
+		respawns.append({"label": str(record.get("label", "野生作物")), "position": [pos.x, pos.y, pos.z], "yield_type": str(record.get("yield_type", "berries")), "seed_type": str(record.get("seed_type", "seeds")), "remaining": maxf(0.0, float(record.get("ready_at", world_time)) - world_time)})
+	return {"harvested_world_crop_ids": harvested_world_crop_ids.duplicate(), "planted_crops": planted, "crop_respawns": respawns, "dynamic_wild_crops": dynamic_crops}
+
+func _restore_world_state(state: Dictionary) -> void:
+	harvested_world_crop_ids.clear()
+	var harvested: Variant = state.get("harvested_world_crop_ids", [])
+	if harvested is Array:
+		for crop_id in harvested:
+			if crop_id is String and not harvested_world_crop_ids.has(crop_id):
+				harvested_world_crop_ids.append(crop_id)
+	for node in interactables.duplicate():
+		if not is_instance_valid(node) or str(node.get_meta("kind", "")) != "crop":
+			continue
+		if harvested_world_crop_ids.has(str(node.get_meta("world_crop_id", ""))):
+			interactables.erase(node)
+			node.queue_free()
+	planted_crops.clear()
+	crop_respawns.clear()
+	var planted: Variant = state.get("planted_crops", [])
+	if planted is Array:
+		for record in planted:
+			if not (record is Dictionary): continue
+			var p: Variant = record.get("position", [])
+			if not (p is Array) or p.size() != 3: continue
+			var pos := Vector3(float(p[0]), float(p[1]), float(p[2]))
+			var plant := Node3D.new()
+			plant.name = "PlayerPlantedCrop"
+			plant.position = pos
+			plant.set_meta("kind", "plant")
+			plant.set_meta("display_name", "玩家種植作物")
+			var mature := bool(record.get("mature", false))
+			plant.set_meta("mature", mature)
+			add_child(plant)
+			var stalk := MeshInstance3D.new()
+			var stalkmesh := CylinderMesh.new()
+			stalkmesh.top_radius = 0.08
+			stalkmesh.bottom_radius = 0.14
+			stalkmesh.height = 0.7
+			stalk.mesh = stalkmesh
+			stalk.material_override = mats["crop"]
+			if mature: stalk.scale = Vector3(1.5, 1.7, 1.5)
+			plant.add_child(stalk)
+			_add_label("READY - E TO HARVEST" if mature else "GROWING", pos + Vector3(0, 1.6, 0), 0.7)
+			var plant_record := {"node": plant, "ready_at": world_time + maxf(0.0, float(record.get("remaining_growth", 0.0)))}
+			plant.set_meta("crop_record", plant_record)
+			planted_crops.append(plant_record)
+			interactables.append(plant)
+	var dynamic_crops: Variant = state.get("dynamic_wild_crops", [])
+	if dynamic_crops is Array:
+		for record in dynamic_crops:
+			if not (record is Dictionary): continue
+			var p: Variant = record.get("position", [])
+			if not (p is Array) or p.size() != 3: continue
+			var restored_crop := _spawn_crop(str(record.get("label", "野生作物")), Vector3(float(p[0]), float(p[1]), float(p[2])), str(record.get("yield_type", "berries")), str(record.get("seed_type", "seeds")))
+			restored_crop.set_meta("dynamic_respawn", true)
+	var respawns: Variant = state.get("crop_respawns", [])
+	if respawns is Array:
+		for record in respawns:
+			if not (record is Dictionary): continue
+			var p: Variant = record.get("position", [])
+			if not (p is Array) or p.size() != 3: continue
+			crop_respawns.append({"label": str(record.get("label", "野生作物")), "pos": Vector3(float(p[0]), float(p[1]), float(p[2])), "yield_type": str(record.get("yield_type", "berries")), "seed_type": str(record.get("seed_type", "seeds")), "ready_at": world_time + maxf(0.0, float(record.get("remaining", 0.0)))})
