 func _restore_world_state(state: Dictionary) -> void:
+	# Make repeated loads idempotent: remove prior restored dynamic crops and player plants first.
+	for node in interactables.duplicate():
+		if not is_instance_valid(node):
+			interactables.erase(node)
+			continue
+		var kind := str(node.get_meta("kind", ""))
+		if kind == "plant" or (kind == "crop" and bool(node.get_meta("dynamic_respawn", false))):
+			interactables.erase(node)
+			node.queue_free()
+	planted_crops.clear()
+	crop_respawns.clear()
 	# The static world is built before loading. Remove harvested static plants so they do not respawn instantly.
 	harvested_world_crop_ids.clear()
