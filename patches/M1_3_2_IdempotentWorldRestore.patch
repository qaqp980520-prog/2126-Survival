+func _add_child_label(parent: Node3D, text: String, local_pos: Vector3, size: float = 2.0) -> void:
+	var label := Label3D.new()
+	label.text = text
+	label.position = local_pos
+	label.font_size = int(24 * size)
+	label.pixel_size = 0.01
+	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+	label.modulate = Color(1, 1, 0.88)
+	parent.add_child(label)
 
 func _world_crop_id(label: String, pos: Vector3) -> String:
