; Engine configuration file.
; This is a small Godot 4 prototype. Gameplay values are prototype-only.
config_version=5

[application]
config/name="Ore Shift - KROLL Mine"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[display]
window/size/viewport_width=760
window/size/viewport_height=700
window/size/window_width_override=760
window/size/window_height_override=700
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
