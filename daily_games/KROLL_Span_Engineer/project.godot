config_version=5

[application]
config/name="KROLL Span Engineer"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1120
window/size/viewport_height=760
window/size/window_width_override=1120
window/size/window_height_override=760
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.06, 1)
